# Knight OAuth — example configuration
#
# Copy to `.env` and edit. Every value here is a default or an illustration;
# nothing in this file is a real secret, and `.env` itself is gitignored.
#
# The service boots with NO configuration at all: `npm start` on a fresh clone
# uses SQLite, generates an RS256 signing key, and serves a working issuer at
# http://127.0.0.1:3010. Everything below is for when you want something else.
#
# 单独部署时无需任何配置即可启动（SQLite + 自动生成 RS256 密钥）。
# 下面所有配置项都是可选的，只有上生产时才需要按需修改。

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3010

# Set to true only when the process sits behind a proxy you control. It makes
# the app trust X-Forwarded-* headers, so enabling it when directly exposed
# lets a client spoof its own source IP past the rate limiter.
TRUST_PROXY=false

# Outside production, plain http is accepted so a first run needs no TLS.
# In production this must stay false: OAuth over http exposes tokens in transit.
# OAUTH_ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------------
# Database — sqlite (default) or postgresql
# ---------------------------------------------------------------------------
# The Prisma schema is generated per provider from prisma/schema.template.prisma.
# After changing the provider, run: npm run db:schema && npm run db:migrate
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/knight-oauth.db

# PostgreSQL, for production:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://knight_oauth:change-me@127.0.0.1:5432/knight_oauth

# Whether the Docker entrypoint applies pending migrations before starting.
# Defaults to true for sqlite and false for postgresql: a single-file SQLite
# deployment should just come up, while several PostgreSQL replicas racing to
# migrate the same database is a real way to corrupt one. Outside Docker this is
# ignored — run `npm run db:migrate` yourself.
# OAUTH_MIGRATE_ON_START=true

# ---------------------------------------------------------------------------
# Identity — the issuer identifier every relying party compares byte-for-byte
# ---------------------------------------------------------------------------
# PUBLIC_BASE_URL is where browsers and clients reach this service. OAUTH_ISSUER
# defaults to it and should only be set separately if you know why you need to.
# Changing the issuer of a live deployment invalidates every token already out
# there, because `iss` no longer matches what clients expect.
PUBLIC_BASE_URL=http://127.0.0.1:3010
# OAUTH_ISSUER=https://oauth.example.com

# ---------------------------------------------------------------------------
# Branding — shown on the login and consent screens
# ---------------------------------------------------------------------------
OAUTH_SERVICE_NAME=Knight OAuth
# OAUTH_LOGO_URL=https://example.com/logo.svg
# OAUTH_SUPPORT_URL=https://example.com/support
OAUTH_PRIMARY_COLOR=#2b6cb0

# ---------------------------------------------------------------------------
# Signing keys
# ---------------------------------------------------------------------------
# RS256 is the default because OpenID Connect Core section 15.1 requires every
# OP to support it, which means any client library works without configuration.
# ES256 produces smaller tokens; EdDSA is the fastest but is not universally
# supported by client libraries yet. Only change this if you know your clients.
OAUTH_SIGNING_ALGORITHM=RS256

# With no key configured, a development or explicitly opted-in deployment
# generates one on first boot and stores it in the database, so tokens survive a
# restart. Concurrent first boots converge on the same database row, but a
# production deployment should still keep private key material outside the app
# database and rotate it independently: supply the key set here and leave
# OAUTH_ALLOW_GENERATED_KEYS=false.
#
# Generate one with: npm run keys:generate
# OAUTH_SIGNING_KEYS_JSON={"keys":[{"kid":"...","alg":"RS256","privateJwk":{...}}]}
# OAUTH_ACTIVE_KID=
# OAUTH_ALLOW_GENERATED_KEYS=false

# ---------------------------------------------------------------------------
# Lifetimes, in seconds
# ---------------------------------------------------------------------------
# OAUTH_AUTHORIZATION_REQUEST_TTL=600     # how long a pending login may sit
# OAUTH_AUTHORIZATION_CODE_TTL=60         # single-use; 60s covers a redirect
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_ID_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=2592000         # 30 days
# OAUTH_SESSION_TTL=86400                 # browser session at this issuer
# OAUTH_REMEMBER_ME_TTL=2592000
# OAUTH_CLOCK_TOLERANCE=0                 # raise only for known skewed clients

# ---------------------------------------------------------------------------
# Local accounts
# ---------------------------------------------------------------------------
# Turn registration off if you want a closed directory, or if all identities
# arrive through an external provider (see below).
OAUTH_REGISTRATION_ENABLED=true

# Keep the OAuth authorization/consent pages while delegating every user login
# to the configured external provider. In production this requires at least one
# OAUTH_EXTERNAL_IDENTITY_PROVIDERS handoff provider.
OAUTH_LOCAL_LOGIN_ENABLED=true

# Requires working SMTP; the service refuses to start in production without it.
OAUTH_REQUIRE_EMAIL_VERIFICATION=false

# 12 characters, following current NIST guidance to favour length over
# composition rules.
OAUTH_MIN_PASSWORD_LENGTH=12

# The first account to register becomes an administrator, so a fresh install has
# an admin without a seeding step. Register your own account before opening the
# service to anyone else, or set this to false and promote an account manually.
OAUTH_FIRST_USER_IS_ADMIN=true

# ---------------------------------------------------------------------------
# Clients
# ---------------------------------------------------------------------------
# RFC 7591 dynamic client registration. Off by default because an open
# registration endpoint lets anyone create a client on your issuer. When on in
# production, an initial access token is required.
OAUTH_DYNAMIC_REGISTRATION_ENABLED=false
# OAUTH_REGISTRATION_ACCESS_TOKEN=

# Whether a client submitted through the web UI needs admin approval before it
# can request tokens, and whether non-admin users may submit one at all.
OAUTH_CLIENT_REQUIRE_APPROVAL=true
OAUTH_CLIENT_ALLOW_USER_REGISTRATION=true

# Clients that should exist before anyone logs in — a first-party relying party
# you deploy alongside this service. Secrets are hashed on import. The client_id
# is the key, so re-running with the same id updates the existing client.
# OAUTH_STATIC_CLIENTS=[{"clientId":"my-app","clientName":"My App","clientSecret":"...","redirectUris":["https://app.example.com/auth/callback"],"grantTypes":["authorization_code","refresh_token"],"scopes":["openid","profile","email","offline_access"],"isFirstParty":true}]

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# PKCE (RFC 7636) is always required for public clients. This governs whether a
# confidential client may skip it; leave it on unless a legacy client forces
# your hand. Only S256 is accepted — `plain` gives no protection against an
# interception attack, so it is not implemented.
OAUTH_REQUIRE_PKCE=true

# `nonce` is REQUIRED by OIDC Core for the implicit flow and RECOMMENDED for the
# authorization code flow. Leaving this false accepts code-flow clients that
# omit it, which is what most libraries do when they rely on PKCE and `state`.
OAUTH_REQUIRE_NONCE=false

# Refresh token rotation: each use issues a new token and revokes the old one.
# Reuse of a rotated token revokes the whole family, on the assumption it leaked.
OAUTH_ROTATE_REFRESH_TOKENS=true

# Rate limits, per minute, in a fixed window.
#
# The login limit covers every endpoint that runs a password hash — sign-in,
# registration, password reset, and the verification resend. Those are
# deliberately expensive (scrypt at N=2^17, about 128 MiB and a fraction of a
# second each) and they are all reachable without an account, so the limit is
# what keeps that cost bounded. Sign-in pays it even for an address that does
# not exist, because paying it is what stops the response time from revealing
# whether the account is real.
#
# Counted twice per request: once against the caller's address and once against
# the identifier they submitted. Both have to pass. Raise the value if your
# users share an outbound address — a NAT'd office reaches ten sign-ins a minute
# without trying — and note that the address half is only as trustworthy as
# TRUST_PROXY.
#
# The window is per process. Several replicas each keep their own, so the
# effective limit is this value times the replica count.
OAUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10

# The token endpoint does not hash passwords, so this one is about brute-forcing
# an authorization code or a refresh token rather than about CPU. It answers
# 429 with a JSON body, not an HTML page.
#
# Read this one before deploying. The identifier half of the key is `client_id`
# from the request body, which a public client sends and a confidential client
# using client_secret_basic does not — its credentials are in the Authorization
# header. So for the common server-side relying party this is a limit per
# address, and one backend making every token request from one address spends a
# single budget for all of its users. 120 a minute is two a second: enough for a
# few thousand users refreshing hourly, and not enough for a busy deployment.
# Raise it rather than discover it.
OAUTH_TOKEN_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Back-channel logout (OIDC Back-Channel Logout 1.0)
# ---------------------------------------------------------------------------
# The one URL on a registered client that this server requests itself, so the
# only one where what a client registers decides what the process connects to.
# Loopback, link-local (including 169.254.169.254, where cloud metadata lives),
# and RFC 1918 addresses are refused by default. Turn this on only if your
# relying parties genuinely sit on the same private network — and note that only
# address literals are judged, since resolving a name here would not survive the
# name changing answer before the request.
# OAUTH_BACKCHANNEL_ALLOW_PRIVATE_NETWORK=false

# OAUTH_BACKCHANNEL_RETRY_SECONDS=60
# OAUTH_BACKCHANNEL_MAX_ATTEMPTS=10
# OAUTH_BACKCHANNEL_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Mail — for email verification and password reset
# ---------------------------------------------------------------------------
# With SMTP_ENABLED=false the service logs the verification link to the console
# instead of sending it, which is fine for local development.
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Knight OAuth <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Custom scopes — deployment-specific scopes the core knows nothing about
# ---------------------------------------------------------------------------
# The core implements only the standard OIDC scopes (openid, profile, email,
# address, phone, offline_access) and the standard claims from OIDC Core
# section 5.4. That is deliberate: a stock client library works against this
# issuer without knowing anything about your deployment.
#
# Anything of your own — a resource scope for your API, an internal user id —
# is declared here. Each entry:
#
#   name         the scope token a client requests. Must not collide with a
#                standard scope; the service refuses to start if it does.
#   description  shown to the user on the consent screen. Write it as the user
#                reads it: "Read your credit balance", not "credits.read".
#   claims       claim names released with this scope, read from the account's
#                `attributes`. Reserved claims (sub, exp, iss, aud, ...) are
#                rejected, so a custom scope can never forge an identity.
#   adminOnly    only an account with the ADMIN role may authorize it.
#   introspectionClaim
#                optional issuer-computed boolean returned by active access-
#                token introspection. It is true only when the token has this
#                scope and the account still satisfies `adminOnly`. It requires
#                adminOnly=true and never comes from account attributes or JWT.
#
# OAUTH_CUSTOM_SCOPES=[{"name":"api.read","description":"Read your data","claims":[]}]

# ---------------------------------------------------------------------------
# External identity providers — reuse a login UI you already have
# ---------------------------------------------------------------------------
# Optional. Without this, accounts are local and this service owns the login
# screen. With it, an existing site can hand an already-authenticated user over,
# so you do not copy a password database.
#
# The `handoff` kind: this service redirects the user to `startUrl`, the upstream
# authenticates them however it likes, and returns a short-lived ticket signed
# with `sharedSecret`. The secret is mandatory and must be at least 32
# characters — an unsigned ticket would mean trusting whatever identity an
# anonymous caller claimed.
#
#   autoCreateUsers  a first-time upstream subject creates a local account.
#                    Leave on unless you pre-provision accounts yourself.
#
# OAUTH_EXTERNAL_IDENTITY_PROVIDERS=[{"name":"main-site","kind":"handoff","displayName":"Main Site","startUrl":"https://www.example.com/oauth2/handoff/start","sharedSecret":"at-least-32-characters-of-random-secret","autoCreateUsers":true,"ticketTtlSeconds":60,"useSubjectAsUserId":true,"syncAdminFromAttribute":"knight_admin"}]

# ---------------------------------------------------------------------------
# Appendix: reproducing a KnightWeb-style deployment
# ---------------------------------------------------------------------------
# The two blocks below are one worked example of the extension points above:
# an issuer whose users live on an existing site, exposing that site's internal
# uid and a credits API to a relying party. Nothing here is required, and
# nothing in the core references it — it is configuration, not code.
#
# OAUTH_CUSTOM_SCOPES=[{"name":"knight_uid","description":"See your Knight UID","claims":["knight_uid"]},{"name":"credits.read","description":"Read your credit balance","claims":[]},{"name":"credits.write","description":"Spend your credits","claims":[]},{"name":"credits.admin","description":"Administer credits for all users","claims":[],"adminOnly":true,"introspectionClaim":"credits_admin"}]
#
# OAUTH_EXTERNAL_IDENTITY_PROVIDERS=[{"name":"knight","kind":"handoff","displayName":"KnightX","startUrl":"https://www.example.com/oauth2/handoff/start","sharedSecret":"replace-with-32-plus-random-characters","autoCreateUsers":true,"useSubjectAsUserId":true,"syncAdminFromAttribute":"knight_admin"}]
#
# The relying party then gets `knight_uid` in its ID token when it requests the
# `knight_uid` scope, and an access token carrying `credits.read` for its API —
# while still being an ordinary OIDC client that could point at any issuer.
