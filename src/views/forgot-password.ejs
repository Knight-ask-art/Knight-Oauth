<%- include("partials/head", { title, branding, hideNav: true }) %>
<div class="card card--narrow">
  <h1>Reset your password</h1>

  <% if (sent) { %>
    <%
    // `sent` is not the service's result, deliberately. It is set whenever the
    // form was submitted, whether or not an address matched an account: reporting
    // which happened would confirm the address is registered.
    %>
    <p class="lede">If that address has an account here, a link to choose a new password is on its way.</p>
    <p class="small muted">The link is good for a short time and can be used once.</p>
    <hr />
    <p class="small"><a href="/login">Back to sign in</a></p>
  <% } else { %>
    <p class="lede">Enter the address you signed up with.</p>
    <% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>
    <form method="post" action="/forgot-password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          autocapitalize="none"
          spellcheck="false"
          required
          autofocus
        />
      </div>
      <button type="submit" class="button--block">Send a reset link</button>
    </form>
    <hr />
    <p class="small"><a href="/login">Back to sign in</a></p>
  <% } %>
</div>
<%- include("partials/foot", { branding }) %>
