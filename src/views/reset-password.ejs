<%- include("partials/head", { title, branding, hideNav: true }) %>
<div class="card card--narrow">
  <h1>Choose a new password</h1>
  <p class="lede">This signs you out everywhere, on every device.</p>

  <% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>

  <form method="post" action="/reset-password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <%
    // The token travels in a hidden field rather than staying in the query string
    // of the POST target, so it does not end up in a referrer or a server log
    // line for the page it submits to.
    %>
    <input type="hidden" name="token" value="<%= token %>" />

    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required autofocus />
      <span class="hint">At least <%= minPasswordLength %> characters. A phrase works well.</span>
    </div>

    <button type="submit" class="button--block">Set new password</button>
  </form>

  <hr />
  <p class="small"><a href="/login">Back to sign in</a></p>
</div>
<%- include("partials/foot", { branding }) %>
