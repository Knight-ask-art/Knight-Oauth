# Copy to deploy/server/.env.production on the server and chmod 600. Never
# commit the filled file. The release process exports OAUTH_IMAGE to the tested
# immutable tag before invoking Compose; leaving it empty fails closed.
OAUTH_IMAGE=
DATABASE_PROVIDER=sqlite
PUBLIC_BASE_URL=https://oauth.knightx.asia
OAUTH_ISSUER=https://oauth.knightx.asia
NODE_ENV=production
OAUTH_ALLOW_INSECURE_HTTP=false
OAUTH_ALLOW_GENERATED_KEYS=false
# These non-secret values must describe a dedicated external network shared by
# Caddy and OAuth only. Check that the subnet is unused before creating it.
OAUTH_PROXY_NETWORK_NAME=knight_oauth_proxy
OAUTH_PROXY_SUBNET=172.31.255.0/29
OAUTH_TRUSTED_PROXY=172.31.255.2
OAUTH_CONTAINER_IP=172.31.255.3
# Bootstrap authority is disabled in the steady-state template. Temporarily set
# both values to true only after the operator-only 403 edge hold is verified;
# set them back to false and recreate OAuth before opening public traffic.
OAUTH_REGISTRATION_ENABLED=false
OAUTH_FIRST_USER_IS_ADMIN=false
# Production ignores the development compose file's optional root .env. Keep
# these allowlists empty unless the release explicitly approves an entry.
OAUTH_STATIC_CLIENTS=[]
OAUTH_EXTERNAL_IDENTITY_PROVIDERS=[]
OAUTH_CUSTOM_SCOPES=[{"name":"knight_uid","description":"See your Knight UID","claims":["knight_uid"]},{"name":"credits.read","description":"Read your credit balance","claims":[]},{"name":"credits.write","description":"Spend your credits","claims":[]},{"name":"credits.admin","description":"Administer credits for all users","claims":[],"adminOnly":true,"introspectionClaim":"credits_admin"}]
# Generate this on the server with: node scripts/generate-keys.js RS256 1
OAUTH_SIGNING_KEYS_JSON=
