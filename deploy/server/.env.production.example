# Copy to the server as .env and chmod 600. Never commit the filled file.
DATABASE_PROVIDER=sqlite
PUBLIC_BASE_URL=https://oauth.knightx.asia
OAUTH_ISSUER=https://oauth.knightx.asia
NODE_ENV=production
OAUTH_ALLOW_INSECURE_HTTP=false
OAUTH_ALLOW_GENERATED_KEYS=false
TRUST_PROXY=1
OAUTH_REGISTRATION_ENABLED=true
OAUTH_FIRST_USER_IS_ADMIN=true
OAUTH_CUSTOM_SCOPES=[{"name":"knight_uid","description":"See your Knight UID","claims":["knight_uid"]},{"name":"credits.read","description":"Read your credit balance","claims":[]},{"name":"credits.write","description":"Spend your credits","claims":[]},{"name":"credits.admin","description":"Administer credits for all users","claims":[],"adminOnly":true,"introspectionClaim":"credits_admin"}]
# Generate this on the server with: node scripts/generate-keys.js RS256 1
OAUTH_SIGNING_KEYS_JSON=
